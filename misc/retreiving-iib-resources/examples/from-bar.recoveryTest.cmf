1_1"/><ComIbmComputeNode label="Recovery Compute" uuid="recoveryTest#FCMComposite_1_2"><computeExpressionProperty xml:space="preserve">
CREATE SCHEMA "" PATH ""

CREATE COMPUTE MODULE RecoveryTestCompute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- ESQL_RECOVERY_CANARY_9F3A2B: grep for this string on the broker work path.
		-- If it appears in a .esql file  -&gt; ESQL is deployed as readable source.
		-- If it appears inside a .cmf    -&gt; ESQL was inlined at BAR build time.
		-- If it appears nowhere          -&gt; ESQL text does not survive deployment.
		SET OutputRoot = InputRoot;
		SET OutputRoot.XMLNSC.result.status = 'recovered';
		SET OutputRoot.XMLNSC.result.marker = 'ESQL_RECOVERY_CANARY_9F3A2B';
		RETURN TRUE;
	END;
END MODULE;</computeExpressionProperty></ComIbmComputeNode><ComIbmWSReplyNode label="HTTP Reply" uuid="recoveryTest#FCMComposite_1_3"/><Connection sourceNode="recoveryTest#FCMComposite_1_1" sourceTerminal="out" targetNode="recoveryTest#FCMComposite_1_2" targetTerminal="in"/><Connection sourceNode="recoveryTest#FCMComposite_1_2" sourceTerminal="out" targetNode="recoveryTest#FCMComposite_1_3" targetTerminal="in"/></MessageFlow>